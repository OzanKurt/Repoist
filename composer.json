{
    "name": "ozankurt/repoist",
    "description": "Repository & criteria generator for Laravel 12.",
    "keywords": ["laravel", "repository", "repoist", "criteria", "database", "generator"],
    "license": "MIT",
    "authors": [
        {
            "name": "Ozan Kurt",
            "email": "ozankurt2@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/console": "^12.0",
        "illuminate/container": "^12.0",
        "illuminate/contracts": "^12.0",
        "illuminate/database": "^12.0",
        "illuminate/filesystem": "^12.0",
        "illuminate/support": "^12.0",
        "spatie/laravel-package-tools": "^1.92"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0",
        "rector/rector": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Kurt\\Repoist\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kurt\\Repoist\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Kurt\\Repoist\\RepoistServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test:coverage": "vendor/bin/pest --coverage",
        "lint": "vendor/bin/pint --test",
        "format": "vendor/bin/pint",
        "stan": "vendor/bin/phpstan analyse --memory-limit=2G"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
